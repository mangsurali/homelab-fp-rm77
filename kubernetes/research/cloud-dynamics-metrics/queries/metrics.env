# PromQL expressions.
# Variables __NAMESPACE__ and __APP__ are replaced by the collector.

# Kubernetes / Container Metrics
CPU_USAGE=sum by (pod) (rate(container_cpu_usage_seconds_total{namespace="__NAMESPACE__",pod=~"__APP__.*",container!="",container!="POD"}[1m]))
CPU_THROTTLED=sum by (pod) (rate(container_cpu_cfs_throttled_seconds_total{namespace="__NAMESPACE__",pod=~"__APP__.*",container!="",container!="POD"}[1m]))
MEMORY_WORKING_SET=sum by (pod) (container_memory_working_set_bytes{namespace="__NAMESPACE__",pod=~"__APP__.*",container!="",container!="POD"})
NETWORK_RX=sum by (pod) (rate(container_network_receive_bytes_total{namespace="__NAMESPACE__",pod=~"__APP__.*"}[1m]))
NETWORK_TX=sum by (pod) (rate(container_network_transmit_bytes_total{namespace="__NAMESPACE__",pod=~"__APP__.*"}[1m]))
RESTARTS=sum by (pod) (kube_pod_container_status_restarts_total{namespace="__NAMESPACE__",pod=~"__APP__.*"})
READY_PODS=sum(kube_pod_status_ready{namespace="__NAMESPACE__",pod=~"__APP__.*",condition="true"})

# Linkerd Metrics - Goodput & Performance Analysis
# Total Request Rate / Throughput (inbound requests/second received by application)
LINKERD_REQUEST_RATE=sum(rate(response_total{namespace="__NAMESPACE__",direction="inbound",pod=~"__APP__.*",authz_name!="probe"}[30s]))

# Goodput RPS (successful requests/second delivered without error)
LINKERD_GOODPUT_RPS=sum(rate(response_total{namespace="__NAMESPACE__",direction="inbound",pod=~"__APP__.*",authz_name!="probe",classification="success"}[30s]))

# Success Rate Ratio (0.0 to 1.0)
LINKERD_SUCCESS_RATE=sum(rate(response_total{namespace="__NAMESPACE__",direction="inbound",pod=~"__APP__.*",authz_name!="probe",classification="success"}[30s])) / clamp_min(sum(rate(response_total{namespace="__NAMESPACE__",direction="inbound",pod=~"__APP__.*",authz_name!="probe"}[30s])), 0.001)

# Error / Failed Request Rate
LINKERD_FAILED_RPS=sum(rate(response_total{namespace="__NAMESPACE__",direction="inbound",pod=~"__APP__.*",authz_name!="probe",classification!="success"}[30s]))

# Inbound Latency Percentiles (p50, p95, p99 in ms)
LINKERD_LATENCY_P50=histogram_quantile(0.50,sum by (le) (rate(response_latency_ms_bucket{namespace="__NAMESPACE__",direction="inbound",pod=~"__APP__.*",authz_name!="probe"}[30s])))
LINKERD_LATENCY_P95=histogram_quantile(0.95,sum by (le) (rate(response_latency_ms_bucket{namespace="__NAMESPACE__",direction="inbound",pod=~"__APP__.*",authz_name!="probe"}[30s])))
LINKERD_LATENCY_P99=histogram_quantile(0.99,sum by (le) (rate(response_latency_ms_bucket{namespace="__NAMESPACE__",direction="inbound",pod=~"__APP__.*",authz_name!="probe"}[30s])))

# Goodput / Throughput Bytes per Second (payload delivered to client)
LINKERD_THROUGHPUT_BYTES=sum(rate(tcp_write_bytes_total{namespace="__NAMESPACE__",direction="inbound",pod=~"__APP__.*",srv_port!="4191"}[30s]))

# Active TCP Connections handled by Linkerd proxy
LINKERD_TCP_CONNECTIONS=sum(tcp_open_connections{namespace="__NAMESPACE__",direction="inbound",pod=~"__APP__.*",srv_port!="4191"})
